---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | DataViz Dashboard</title>
  </head>
  <body class="bg-slate-50 flex h-screen overflow-hidden text-slate-800 font-sans">
    
    <!-- Barre latérale (Sidebar) sombre et sobre -->
    <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col hidden md:flex">
      <div class="h-16 flex items-center px-6 border-b border-slate-800 bg-slate-950">
        <span class="font-extrabold text-lg text-white uppercase tracking-wider">Data Dashboard</span>
      </div>
      
      <nav class="flex-1 py-6 px-4 space-y-1 overflow-y-auto">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 mt-2 px-2">Vue d'ensemble</div>
        <a href="/" class="block px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors text-sm font-medium">Accueil</a>
        
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 mt-8 px-2">Intégrations (TP)</div>
        <a href="/boucle-pingouins" class="block px-4 py-2.5 rounded-lg hover:bg-blue-900/30 hover:text-blue-400 transition-colors border-l-2 border-transparent hover:border-blue-400 text-sm font-medium">Boucle Map</a>
        <a href="/rendu-dynamique" class="block px-4 py-2.5 rounded-lg hover:bg-emerald-900/30 hover:text-emerald-400 transition-colors border-l-2 border-transparent hover:border-emerald-400 text-sm font-medium">Rendu Dynamique</a>
        <a href="/rendu-statique" class="block px-4 py-2.5 rounded-lg hover:bg-purple-900/30 hover:text-purple-400 transition-colors border-l-2 border-transparent hover:border-purple-400 text-sm font-medium">Rendu Statique</a>
      </nav>
      
      <div class="p-4 border-t border-slate-800">
        <div class="text-xs font-medium text-slate-400">Enzo HILLAIRET</div>
        <div class="text-[10px] text-slate-500 mt-0.5">B.U.T. MMI 2 - Communication</div>
      </div>
    </aside>

    <!-- Zone de contenu principal -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
      <!-- En-tête de la page active -->
      <header class="h-16 bg-white border-b border-slate-200 flex items-center px-8 shadow-sm shrink-0">
        <h1 class="text-lg font-bold text-slate-700">{title}</h1>
      </header>
      
      <!-- Contenu défilant -->
      <main class="flex-1 overflow-y-auto p-8">
        <slot />
      </main>
    </div>
    
  </body>
</html>