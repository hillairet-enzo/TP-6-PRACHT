---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Accueil">
  <div class="max-w-4xl py-6">
    <h2 class="text-3xl font-bold text-slate-800 mb-4">Tableau de bord DataViz</h2>
    <p class="text-slate-600 mb-6 text-lg">
      Bienvenue sur l'application d'analyse de données. Utilisez le menu latéral à gauche pour explorer les différents jeux de données.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h3 class="font-bold text-slate-800 mb-2">Pingouins</h3>
        <p class="text-sm text-slate-500 mb-4">Analyse morphologique et répartition par espèce.</p>
        <a href="/boucle-pingouins" class="text-blue-600 font-medium text-sm hover:underline">Accéder →</a>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h3 class="font-bold text-slate-800 mb-2">Voitures</h3>
        <p class="text-sm text-slate-500 mb-4">Étude des motorisations et performances techniques.</p>
        <a href="/boucle-voitures" class="text-blue-600 font-medium text-sm hover:underline">Accéder →</a>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h3 class="font-bold text-slate-800 mb-2">Bourse (Apple)</h3>
        <p class="text-sm text-slate-500 mb-4">Évolution historique et interactivité client-side.</p>
        <a href="/interactif-apple" class="text-blue-600 font-medium text-sm hover:underline">Accéder →</a>
      </div>
    </div>
  </div>
</Layout>