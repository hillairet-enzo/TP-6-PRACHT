---
import Layout from '../../layouts/Layout.astro';

// Désactivation du pré-rendu (Consigne du TP)
export const prerender = false;

// Récupération du paramètre dans l'URL
const { cylindres } = Astro.params;
---

<Layout title={`Dynamique : ${cylindres} Cylindres`}>
  <div class="mb-8">
    <a href="/rendu-dynamique-voitures" class="text-slate-500 hover:text-slate-800 text-sm mb-4 inline-block">← Retour au menu</a>
    <h1 class="text-2xl font-bold text-slate-800">Moteur {cylindres} Cylindres (SSR)</h1>
  </div>
  
  <div id="graphique" data-cylindre={cylindres} class="bg-white p-6 rounded-xl shadow-sm border border-slate-200"></div>

  <script>
    import * as Plot from "@observablehq/plot";
    import cars from "../../assets/cars.json";

    const conteneur = document.querySelector('#graphique');
    const cylindreNum = Number(conteneur?.getAttribute('data-cylindre'));
    
    const dataFiltree = cars.filter((c: any) => c.cylinders === cylindreNum);

    if (conteneur) {
      const plot = Plot.plot({
        width: 600,
        height: 350,
        marks: [
          Plot.dot(dataFiltree, { x: "power (hp)", y: "economy (mpg)", fill: "#3b82f6", tip: true })
        ]
      });
      conteneur.append(plot);
    }
  </script>
</Layout>